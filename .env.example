# Exchange WebSocket endpoints (public, no API key required)
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_SYMBOL=btcusdt
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
COINBASE_PRODUCT_ID=BTC-USD

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_TRADES=trades
KAFKA_TOPIC_ORDERBOOK=orderbook

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_pulse
POSTGRES_USER=crypto_pulse
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# WebSocket API (serves the dashboard)
WEBSOCKET_API_PORT=8080

# Dashboard (React app dev server)
DASHBOARD_PORT=3000
